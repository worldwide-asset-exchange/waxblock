BLOCKCHAIN_BLOCK=https://wax.eosusa.io
BLOCKCHAIN_TRANSACTION=https://wax.eosusa.io
BLOCKCHAIN_HISTORY=https://wax.eosusa.io
LIGHT_API=https://wax.light-api.net

SIMPLEASSETS=
ATOMICASSETS=https://wax.api.atomicassets.io

ASSETS_COUNT=461118992
ASSETS_COUNT_TIMESTAMP=1765252639411

# Optional
# CACHE_DIR=cache
# HEALTH_MAX_HEAD_AGE_SECONDS=60

# Required in production: the origin key we send you privately (docs/install/reverse-proxy.md).
ORIGIN_AUTH_KEY=
