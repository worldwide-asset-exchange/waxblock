{
  "family": "waxblock-api-mainnet",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "ghcr.io/worldwide-asset-exchange/waxblock-api:v1.3.1",
      "essential": true,
      "user": "1000:1000",
      "readonlyRootFilesystem": true,
      "portMappings": [
        {
          "name": "http",
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NETWORK_TYPE",
          "value": "mainnet"
        },
        {
          "name": "PORT",
          "value": "8080"
        },
        {
          "name": "BLOCKCHAIN_DEFAULT",
          "value": "https://wax.eosusa.io"
        },
        {
          "name": "BLOCKCHAIN_STATE",
          "value": "https://wax.eosusa.io"
        },
        {
          "name": "BLOCKCHAIN_BLOCK",
          "value": "https://wax.eosusa.io"
        },
        {
          "name": "BLOCKCHAIN_TRANSACTION",
          "value": "https://wax.eosusa.io"
        },
        {
          "name": "BLOCKCHAIN_HISTORY",
          "value": "https://wax.eosusa.io"
        },
        {
          "name": "LIGHT_API",
          "value": "https://wax.light-api.net"
        },
        {
          "name": "ATOMICASSETS",
          "value": "https://wax.api.atomicassets.io"
        },
        {
          "name": "ASSETS_COUNT",
          "value": "461118992"
        },
        {
          "name": "ASSETS_COUNT_TIMESTAMP",
          "value": "1765252639411"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "cache",
          "containerPath": "/app/apps/api/cache"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -qO- http://127.0.0.1:8080/api/v1/health >/dev/null || exit 1"
        ],
        "interval": 30,
        "timeout": 8,
        "retries": 3,
        "startPeriod": 300
      },
      "stopTimeout": 20,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/waxblock/api-mainnet",
          "awslogs-create-group": "true",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ],
  "volumes": [
    {
      "name": "cache"
    }
  ]
}
